# VAPN production configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Step-by-step walkthrough of every value: docs/builder/installation.md
# Full reference (types, defaults, accepted values): docs/reference/configuration.md
#
# Each setting below is marked:
#   [required]  the stack will not work without it
#   [optional]  has a working default; change only if you need to
#   [secret]    never commit, never paste into chat, never put on a worker
#
# Generate secrets with:  openssl rand -hex 32
#
# Sanity-check before starting — this prints every required value you left blank:
#   grep -E '^(VAPN_DOMAIN|VAPN_ADMIN_ALLOW_CIDR|VAPN_DB_PASSWORD|VAPN_ADMIN_TOKEN|VAPN_SNAPSHOT_SIGNING_KEY|VAPN_ADVISOR_URL|VAPN_ADVISOR_TOKEN|VAPN_ARTIFACT_S3_ENDPOINT|VAPN_ARTIFACT_S3_ACCESS_KEY|VAPN_ARTIFACT_S3_SECRET_KEY)=$' .env

# --- identity -----------------------------------------------------------
# [required] Public domain workers connect to (Caddy obtains TLS automatically).
VAPN_DOMAIN=probes.example.com
# [required] CIDRs allowed to reach /admin/v1 through the edge. Space-separated,
# no commas. This is the machine you run `vapnctl` FROM — normally your laptop,
# not this VM. Find it with: curl -s ifconfig.me
VAPN_ADMIN_ALLOW_CIDR=203.0.113.7/32

# --- edge ports ---------------------------------------------------------
# [optional] Ports the HTTPS edge listens on. Change these only if this machine
# already serves something on 80/443 — otherwise `docker compose up -d` fails
# with "failed to bind host port 0.0.0.0:80/tcp: address already in use".
#
# Certificates: Caddy proves ownership of your domain over public port 80
# (HTTP-01) or public port 443 (TLS-ALPN-01), and it skips whichever of those
# you move. So:
#   • moving only HTTP  → certificates still issue automatically over 443.
#   • moving HTTPS too  → automatic issuance cannot work. Put VAPN behind the
#     proxy that owns 443, or supply your own certificate. Workers must then be
#     told the port too: VAPN_COORDINATOR_URL=https://probes.example.com:8443
# Full guidance: docs/operations/deployment.md#running-alongside-another-service
VAPN_CADDY_HTTP_PORT=80
VAPN_CADDY_HTTPS_PORT=443

# --- images -------------------------------------------------------------
# [optional] Release tag to run (see docs/operations/releases-and-upgrades.md).
VAPN_VERSION=latest
# [optional] Image name prefix; each component appends -<component>.
# VAPN_IMAGE_PREFIX=ghcr.io/hummingbytedev/vapn

# --- secrets ------------------------------------------------------------
# [required][secret] Password for the in-stack postgres. Also composed into
# every service's VAPN_DB_DSN, so changing it later means recreating the volume.
VAPN_DB_PASSWORD=
# [required][secret] Bearer token for /admin/v1 and the `vapnctl` CLI.
VAPN_ADMIN_TOKEN=
# [required][secret] Snapshot signing key — the PRIVATE half of a keypair you
# generate once, from the repository root, with:
#   docker build --build-arg COMPONENT=keygen -t vapn-keygen . && docker run --rm vapn-keygen
# (or `make build && ./bin/keygen` if you have Go). It prints BOTH halves.
# The private key lives ONLY here, on the builder host. Never put it on a worker.
# Losing it means re-issuing a new public key to every worker operator.
# See docs/builder/installation.md step 3.
VAPN_SNAPSHOT_SIGNING_KEY=
# [record-keeping] The PUBLIC half from the same keygen run. No service in this
# stack reads it — it is listed here so you keep it with its private half. You
# must hand it to every worker operator; `vapn install` prompts them for it, and
# their worker refuses any snapshot it cannot verify with this key. The builder
# also logs it at the start of each run ("artifact publication enabled").
# VAPN_SNAPSHOT_PUBLIC_KEY=

# --- VPS Advisor --------------------------------------------------------
# [required] Base URL only, no path: the client appends /api/v1/monitoring/...
# itself. A trailing /api here causes 404s on every provider sync.
#
# It must also be the host that answers *directly*. If www.<site> redirects to
# the apex (or the reverse), configure the destination: a cross-host redirect
# drops the Authorization header, so the platform refuses to follow one.
#
# Everything the platform learns from the website comes through this value —
# the provider catalog, worker enrolments and administrator approvals. A wrong
# value looks like three faults at once: no snapshots published, workers that
# never appear, and approved workers stuck "awaiting approval".
# Check it any time with: vapnctl status
VAPN_ADVISOR_URL=https://www.vpsadvisor.example
# [required][secret] Service credential issued by the VPS Advisor website team.
VAPN_ADVISOR_TOKEN=

# --- artifact store (any S3-compatible provider) ------------------------
# Where signed snapshots are published for workers to download. Keep the bucket
# private and scope the key pair to it; the store is untrusted by design — the
# signature is what makes the snapshot trustworthy.
# Uncomment ONE provider block below. The endpoint is a HOST — no https://,
# no bucket name, no trailing path.
#
# --- Backblaze B2 -------------------------------------------------------
# Endpoint and region both come from the bucket's page in the B2 console.
# Create the key under "Application Keys" and scope it to this one bucket.
# The account MASTER key does not work with the S3 API — it must be an
# application key, whose ID is longer than the bare account ID.
VAPN_ARTIFACT_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
VAPN_ARTIFACT_S3_REGION=us-west-004
VAPN_ARTIFACT_S3_BUCKET=vapn-artifacts
VAPN_ARTIFACT_S3_ACCESS_KEY=
VAPN_ARTIFACT_S3_SECRET_KEY=
#
# --- Cloudflare R2 ------------------------------------------------------
# Account ID: R2 → Overview, right-hand sidebar. Create the credential under
# "Manage R2 API Tokens" with Object Read & Write scoped to this bucket; use
# the "Access Key ID" and "Secret Access Key" it shows once. R2's region is
# always the literal string "auto".
# VAPN_ARTIFACT_S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# VAPN_ARTIFACT_S3_REGION=auto
# VAPN_ARTIFACT_S3_BUCKET=vapn-artifacts
# VAPN_ARTIFACT_S3_ACCESS_KEY=
# VAPN_ARTIFACT_S3_SECRET_KEY=
#
# --- AWS S3 -------------------------------------------------------------
# VAPN_ARTIFACT_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
# VAPN_ARTIFACT_S3_REGION=eu-central-1
# VAPN_ARTIFACT_S3_BUCKET=vapn-artifacts
# VAPN_ARTIFACT_S3_ACCESS_KEY=
# VAPN_ARTIFACT_S3_SECRET_KEY=
#
# The bucket must already exist — the builder uploads into it and never
# creates it. Nothing appears in it until a build actually runs; the builder
# is a scheduled one-shot, not a long-running service, so `docker compose
# up -d` alone never publishes anything. See docs/builder/installation.md.

# --- GeoIP (bring your own MaxMind account) -----------------------------
# [required for the geoip profile] Free account at maxmind.com. The GeoLite2
# databases must not be redistributed, which is why you supply your own key.
# NOTE: no VAPN_ prefix — these are read by the geoipupdate container.
# Run `docker compose --profile geoip up -d` and WAIT for the download before
# the first build: the builder fails at "geo enrichment" if the file is absent.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# [optional] Directory the mmdb files live in (shared with builder + coordinator).
VAPN_GEOIP_DIR=./geoip

# --- builder ------------------------------------------------------------
# [optional] RIS collector to build from. rrc00 (Amsterdam, multihop) is the
# default; switch to another (e.g. rrc01) only if it is unavailable.
VAPN_RIS_BVIEW_URL=https://data.ris.ripe.net/rrc00/latest-bview.gz
#
# Builder tuning knobs all have sensible defaults and are deliberately NOT
# listed here — target caps, sanity-gate threshold, snapshot retention, minimum
# worker version. See docs/reference/configuration.md#builder if you need them.

# --- monitoring profile -------------------------------------------------
# [optional] Grafana admin password (docker compose --profile monitoring up -d).
VAPN_GRAFANA_PASSWORD=

# --- backups ------------------------------------------------------------
# IMPORTANT: scripts/backup.sh reads these from its PROCESS ENVIRONMENT, and the
# shipped vapn-backup.service has no EnvironmentFile — so setting them HERE has
# NO EFFECT on the scheduled nightly backup. To configure the offsite copy, add
# them to the unit instead:
#
#   sudo systemctl edit vapn-backup.service
#   [Service]
#   Environment=VAPN_BACKUP_S3_URI=s3://your-bucket/vapn-backups
#   Environment=VAPN_BACKUP_KEEP=14
#
# The offsite copy also needs an S3 CLI (aws or mc) configured for root.
# A backup on the same disk as the database is not a backup.
# See docs/operations/backup-restore.md.
