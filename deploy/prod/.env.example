# VAPN production configuration. Copy to .env and fill in every value.
# Secrets: generate with  openssl rand -hex 32  unless noted otherwise.

# --- identity -----------------------------------------------------------
# Public domain workers connect to (Caddy obtains TLS automatically).
VAPN_DOMAIN=probes.example.com
# CIDRs allowed to reach /admin/v1 through the edge (comma-free, space-separated).
VAPN_ADMIN_ALLOW_CIDR=203.0.113.7/32

# --- images -------------------------------------------------------------
# Release tag to run (see docs/operations/releases-and-upgrades.md).
VAPN_VERSION=latest
# VAPN_IMAGE_PREFIX=ghcr.io/hummingbytedev/vapn

# --- secrets ------------------------------------------------------------
VAPN_DB_PASSWORD=
VAPN_ADMIN_TOKEN=
# Snapshot signing keypair: generate once, from the repository root, with
#   docker build --build-arg COMPONENT=keygen -t vapn-keygen . && docker run --rm vapn-keygen
# (or `make build && ./bin/keygen` if you have Go). It prints both halves.
# The private key lives ONLY here (builder). Workers pin the public key.
# See docs/builder/installation.md step 3.
VAPN_SNAPSHOT_SIGNING_KEY=

# --- VPS Advisor --------------------------------------------------------
# Base URL only, no path: the client appends /api/v1/monitoring/... itself.
VAPN_ADVISOR_URL=https://www.vpsadvisor.example
VAPN_ADVISOR_TOKEN=

# --- artifact store (any S3-compatible provider) ------------------------
# Backblaze B2 (recommended):  s3.us-west-004.backblazeb2.com + key pair
# Cloudflare R2:               <account>.r2.cloudflarestorage.com, region auto
# AWS S3:                      s3.amazonaws.com + region
VAPN_ARTIFACT_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
VAPN_ARTIFACT_S3_REGION=
VAPN_ARTIFACT_S3_BUCKET=vapn-artifacts
VAPN_ARTIFACT_S3_ACCESS_KEY=
VAPN_ARTIFACT_S3_SECRET_KEY=

# --- GeoIP (bring your own MaxMind account) -----------------------------
# Used by the geoip profile (docker compose --profile geoip up -d).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Directory the mmdb files live in (shared with builder + coordinator).
VAPN_GEOIP_DIR=./geoip

# --- builder ------------------------------------------------------------
# RIS collector to build from. rrc00 (Amsterdam, multihop) is the default.
VAPN_RIS_BVIEW_URL=https://data.ris.ripe.net/rrc00/latest-bview.gz

# --- monitoring profile -------------------------------------------------
VAPN_GRAFANA_PASSWORD=
